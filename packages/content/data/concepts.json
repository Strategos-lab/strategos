      "\\b(?:either way|whichever (?:way|\\S+ (?:does|do|chooses|choose|picks|pick))|whatever (?:\\S+ )?(?:does|do|chooses|choose|picks|pick|happens)|no matter (?:what|which|how)|regardless|in (?:every|each|both|all) cases?|every time|in any case)\\b.*\\b(?:better|best|more|less|worse|cheaper|quicker|easier|suits?|beats?|wins?)\\b",
      "\\balways (?:better|best|beats?|wins?|gives (?:you |them |\\S+ )?more)\\b"
    ]
  },
