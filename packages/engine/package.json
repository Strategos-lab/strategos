{
  "name": "@strategos/engine",
  "version": "1.0.0",
  "private": true,
  "description": "STRATEGOS deterministic game-theory engine: exact rational arithmetic, no AI, no floats in solver logic",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "^4.10.2",
    "rolldown": "1.2.12",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
